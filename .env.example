# HIVE environment variable template — NAMES ONLY.
# Copy to .env.local and fill locally. NEVER commit real values.

# --- Supabase (project URL and anon key are client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER-ONLY — never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (SERVER-ONLY, free tier only; no paid fallbacks) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Embeddings (SERVER-ONLY) ---
# Supported: "local-e5-small" (384, default) | "gemini" (verify output dimension)
EMBEDDING_PROVIDER=local-e5-small
# Validated against actual model output at ingestion. Never assume 768.
EMBEDDING_DIMENSION=384

# --- Web Push VAPID (SERVER-ONLY private key; public key is client-safe) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Rate limiting / quotas ---
AI_DAILY_QUESTION_LIMIT=20

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
